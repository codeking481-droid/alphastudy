# Alpha Study — Environment Variables

# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT (.env.local)
# Copy this to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════════════════════════

# Frontend (Vite — build time only, leave empty to use same-origin)
# VITE_API_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER (.env in server/ directory)
# Copy to server/.env — these are NEVER exposed to the browser.
# ═══════════════════════════════════════════════════════════════════════════════

# Database — REQUIRED
DATABASE_URL=postgresql://postgres:password@localhost:5432/alpha_study

# API Server
API_PORT=3001
APP_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info

# Auth — REQUIRED (change in production!)
JWT_SECRET=change-this-to-a-secure-random-string-min-16-chars

# Groq AI (optional)
GROQ_API_KEY=

# ALOC API (optional)
ALOC_API_KEY=
