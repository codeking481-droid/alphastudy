# Database (server only) — REQUIRED
DATABASE_URL=postgresql://postgres:password@localhost:5432/alpha_study

# API Server (server only)
API_PORT=3001
APP_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info

# Auth (server only)
JWT_SECRET=change-this-to-a-secure-random-string-min-16-chars

# Groq AI (server only — optional for now)
GROQ_API_KEY=

# ALOC API (server only — optional)
ALOC_API_KEY=
